@page "/Login"
@using BlazorAppAuthStateProvider.Client.AuthProvider
@inject NavigationManager navi;
<h3>LoginPage</h3>

<span>
    @tokenS
</span>
<p></p>
<button @onclick="Login">Login Now !</button>
@code {
    HttpClient _httpClient = new();
    string tokenS = "";
    public async Task Login()
    {
        var response = await _httpClient.PostAsJsonAsync("https://localhost:7186/api/Login", new { Username = "s", Password = "s" });
        if (response.IsSuccessStatusCode)
        {
            var token = await response.Content.ReadAsStringAsync();
            tokenS = token;


            if (!string.IsNullOrWhiteSpace(token))
            {
                ((CustomAuthStateProvider)AuthStateProvider).MakeUserAuthenticated(token);
                navi.NavigateTo("/");
            }
        }
      //  return false;
    }
}
